{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"link": true,
			"palette": [
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "primary-black",
					"color": "#0a0a0a",
					"name": "Primary Black"
				},
				{
					"slug": "charcoal",
					"color": "#1a1a1a",
					"name": "Charcoal"
				},
				{
					"slug": "dark-gray",
					"color": "#2d2d2d",
					"name": "Dark Gray"
				},
				{
					"slug": "medium-gray",
					"color": "#4a4a4a",
					"name": "Medium Gray"
				},
				{
					"slug": "light-gray",
					"color": "#6b6b6b",
					"name": "Light Gray"
				},
				{
					"slug": "pale-gray",
					"color": "#a8a8a8",
					"name": "Pale Gray"
				},
				{
					"slug": "off-white",
					"color": "#f5f5f5",
					"name": "Off White"
				},
				{
					"slug": "background-gray",
					"color": "#fafafa",
					"name": "Background Gray"
				},
				{
					"slug": "border-gray",
					"color": "#e5e5e5",
					"name": "Border Gray"
				},
				{
					"slug": "accent-green",
					"color": "#00d395",
					"name": "Accent Green"
				},
				{
					"slug": "hover-green",
					"color": "#00b380",
					"name": "Hover Green"
				},
				{
					"slug": "accent-blue",
					"color": "#0066ff",
					"name": "Accent Blue"
				},
				{
					"slug": "text-muted",
					"color": "#737373",
					"name": "Muted Text"
				}
			],
			"gradients": [
				{
					"slug": "black-to-transparent",
					"gradient": "linear-gradient(180deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%)",
					"name": "Black to Transparent"
				},
				{
					"slug": "white-to-transparent",
					"gradient": "linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 100%)",
					"name": "White to Transparent"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'SF Pro Display', 'Inter', system-ui, sans-serif",
					"slug": "system-sans",
					"name": "System Sans"
				},
				{
					"fontFamily": "'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace",
					"slug": "monospace",
					"name": "Monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"size": "0.75rem",
					"name": "Extra Small",
					"fluid": false
				},
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "1.125rem",
					"name": "Large",
					"fluid": false
				},
				{
					"slug": "x-large",
					"size": "1.25rem",
					"name": "Extra Large",
					"fluid": false
				},
				{
					"slug": "xx-large",
					"size": "1.375rem",
					"name": "2X Large",
					"fluid": false
				},
				{
					"slug": "xxx-large",
					"size": "1.75rem",
					"name": "3X Large",
					"fluid": {
						"min": "1.5rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xxxx-large",
					"size": "2.25rem",
					"name": "4X Large",
					"fluid": {
						"min": "1.875rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "huge",
					"size": "3rem",
					"name": "Huge",
					"fluid": {
						"min": "2.5rem",
						"max": "3rem"
					}
				},
				{
					"slug": "gigantic",
					"size": "3.5rem",
					"name": "Gigantic",
					"fluid": {
						"min": "3rem",
						"max": "3.5rem"
					}
				},
				{
					"slug": "colossal",
					"size": "4.5rem",
					"name": "Colossal",
					"fluid": {
						"min": "3.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"%",
				"em",
				"rem",
				"vh",
				"vw"
			],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "10",
					"size": "0.25rem",
					"name": "1"
				},
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "2"
				},
				{
					"slug": "30",
					"size": "0.75rem",
					"name": "3"
				},
				{
					"slug": "40",
					"size": "1rem",
					"name": "4"
				},
				{
					"slug": "50",
					"size": "1.5rem",
					"name": "5"
				},
				{
					"slug": "60",
					"size": "2rem",
					"name": "6"
				},
				{
					"slug": "70",
					"size": "3rem",
					"name": "7"
				},
				{
					"slug": "80",
					"size": "4rem",
					"name": "8"
				},
				{
					"slug": "90",
					"size": "5rem",
					"name": "9"
				},
				{
					"slug": "100",
					"size": "6rem",
					"name": "10"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"dimensions": {
			"minHeight": true
		},
		"position": {
			"sticky": true
		},
		"shadow": {
			"presets": [
				{
					"name": "Small",
					"slug": "small",
					"shadow": "0 1px 2px rgba(0, 0, 0, 0.05)"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"shadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)"
				},
				{
					"name": "Large",
					"slug": "large",
					"shadow": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)"
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"shadow": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
				},
				{
					"name": "Card",
					"slug": "card",
					"shadow": "0 0 0 1px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.05)"
				},
				{
					"name": "Card Hover",
					"slug": "card-hover",
					"shadow": "0 0 0 1px rgba(0, 0, 0, 0.05), 0 4px 12px rgba(0, 0, 0, 0.1)"
				}
			]
		},
		"custom": {
			"borderRadius": {
				"small": "4px",
				"medium": "8px",
				"large": "12px",
				"full": "9999px"
			},
			"lineHeight": {
				"tight": "1.2",
				"snug": "1.4",
				"normal": "1.6",
				"relaxed": "1.8",
				"loose": "2"
			},
			"fontWeight": {
				"normal": "400",
				"medium": "500",
				"semibold": "600",
				"bold": "700"
			},
			"transition": {
				"fast": "150ms ease",
				"base": "250ms ease",
				"slow": "350ms ease"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--primary-black)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--50)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-black)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--medium-gray)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--primary-black)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--colossal)",
					"fontWeight": "400",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxxx-large)",
					"fontWeight": "400",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": "400",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "400",
					"lineHeight": "1.4"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "400",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "400",
					"lineHeight": "1.5",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary-black)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500",
					"lineHeight": "1"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"right": "24px",
						"bottom": "12px",
						"left": "24px"
					}
				},
				"border": {
					"radius": "var(--wp--custom--border-radius--medium)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--charcoal)"
					}
				}
			}
		},
		"blocks": {
			"core/cover": {
				"elements": {
					"h2": {
						"typography": {
							"textTransform": "uppercase"
						}
					}
				}
			}
		}
	},
	"customTemplates": [],
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}